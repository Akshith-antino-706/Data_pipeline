{
  // Type-checking foundation. JS stays JS: allowJs with checkJs off means nothing changes at
  // runtime. Opt a file in with `// @ts-check` at the top, or convert it to .ts later.
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    // Keep every value import exactly as written (no elision of unused imports), so tsx
    // runs the same module side effects the original JavaScript did.
    "verbatimModuleSyntax": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["server.ts", "src/**/*", "tests/**/*"],
  "exclude": ["node_modules", "src/migrations"]
}
