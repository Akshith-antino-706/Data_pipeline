# Dev database (rayna-dev-db on RDS). Never point this at raynadb (prod).
# Copy to backend/.env.dev (git-ignored) and fill in the endpoint and password.
APP_ENV=dev
DB_HOST=rayna-dev-db.<id>.eu-north-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=rayna_dev
DB_USER=raynadb
DB_PASS=
DB_SSL=true

# ── Server ───────────────────────────────────────────────
PORT=3002
NODE_ENV=development
BACKEND_URL=http://localhost:3002
TRACKING_BASE_URL=http://localhost:3002
# Generate a dev-only value: openssl rand -hex 32
JWT_SECRET=

# ── Redis / BullMQ: LOCAL ONLY. Never point at prod Redis ─
REDIS_URL=redis://127.0.0.1:6379

# ── Read-only sources (same values as prod .env) ─────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
BQ_PROJECT_ID=
BQ_DATASET=
BQ_FULL_TABLE=
BQ_SYNC_ENABLED=false
MYSQL_HOST=
MYSQL_PORT=
MYSQL_USER=
MYSQL_PASS=
MYSQL_DB=
MYSQL_SYNC_ENABLED=false
MYSQL2_HOST=
MYSQL2_PORT=
MYSQL2_USER=
MYSQL2_PASS=
MYSQL2_DB=
RAYNA_BILLING_API_URL=
RAYNA_BILLING_API_TOKEN=
GTM_CONTAINER_ID=

# ── Journey archive viewer (S3, read-only) ───────────────
# Credentials come from the default AWS chain (EC2 role in prod, `aws configure` locally).
ARCHIVE_VIEW_ENABLED=false
ARCHIVE_S3_BUCKET=rayna-journey-archive-022278165625
ARCHIVE_S3_REGION=eu-north-1

# ── Sending: OFF in dev. Left blank ON PURPOSE ───────────
# Fill only with sandbox/test accounts — never prod's.
WELCOME_ENABLED=false
OTP_ENABLED=false
EMAIL_OVERRIDE_TO=
JOURNEY_TEST_EMAILS=
EMAIL_PROVIDER=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
EMAIL_FROM=
EMAIL_FROM_NAME=
SENDGRID_API_KEY=
CHATHEAD_API_TOKEN=
CHATHEAD_APP_KEY=
GUPSHUP_SMS_USER_ID=
GUPSHUP_SMS_PASSWORD=
GUPSHUP_RCS_USER_ID=
GUPSHUP_RCS_PASSWORD=
GUPSHUP_CTM_TOKEN=
GUPSHUP_CTM_SERVICE_ID=
GIVEAWAY_SMTP_HOST=
GIVEAWAY_SMTP_USER=
GIVEAWAY_SMTP_PASS=
AFFILIATE_SMTP_HOST=
AFFILIATE_SMTP_USER=
AFFILIATE_SMTP_PASS=
# Prod CloudAMQP — do NOT set; a 2nd consumer would steal prod's queue
GIVEAWAY_RABBITMQ_URL=
IMAP_USER=
IMAP_PASSWORD=
